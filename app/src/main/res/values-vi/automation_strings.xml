    <string name="settings_automation">Tự động hóa</string>
    <string name="settings_automation_desc">Tác vụ, vòng lặp và độ chính xác của lịch</string>
    <string name="automation_ai_tools">Truy cập tác vụ và vòng lặp</string>
    <string name="automation_ai_tools_desc">Cho phép mô hình tạo và quản lý tác vụ hoặc bắt đầu và dừng vòng lặp cuộc trò chuyện. Mặc định tắt.</string>
    <string name="automation_background_execution">Thực thi trong nền</string>
    <string name="automation_wake_lock">Khóa đánh thức</string>
    <string name="automation_wake_lock_desc">Giữ thiết bị thức trong mỗi lần chạy tác vụ hoặc vòng lặp. WorkManager đã xử lý công việc theo lịch thông thường; khóa bổ sung này có thể làm tăng mức dùng pin.</string>
    <string name="automation_battery_optimization">Tối ưu hóa pin</string>
    <string name="automation_battery_optimization_ignored_desc">Không tối ưu hóa; Android có thể cho phép nhiều công việc nền hơn, nhưng hạn chế của nhà sản xuất vẫn có thể áp dụng</string>
    <string name="automation_battery_optimization_active_desc">Đang tối ưu hóa; Android có thể trì hoãn công việc nền và hạn chế của nhà sản xuất vẫn có thể áp dụng</string>
    <string name="automation_exact_execution">Thực thi chính xác</string>
    <string name="automation_exact_execution_on_desc">Dùng báo thức chính xác cho tác vụ và vòng lặp. Android vẫn có thể áp dụng giới hạn hệ thống.</string>
    <string name="automation_exact_execution_off_desc">Dùng báo thức không chính xác để tiết kiệm pin. Bật để yêu cầu quyền truy cập Báo thức và lời nhắc.</string>
    <string name="automation_exact_execution_off_legacy_desc">Dùng báo thức không chính xác để tiết kiệm pin. Trên phiên bản Android này, bạn có thể bật thực thi chính xác mà không cần quyền bổ sung.</string>
    <!-- Daemon Mode, Heartbeat, SMS and Notifications -->
