    <string name="automation_sms">SMS</string>
    <string name="sms_read_enabled">Читать входящие SMS</string>
    <string name="sms_read_enabled_desc">Разрешить Agora читать входящие SMS-сообщения (требуется разрешение READ_SMS)</string>
    <string name="sms_send_enabled">Отправлять SMS от вашего имени</string>
    <string name="sms_send_enabled_desc">Разрешить Agora создавать черновики SMS для проверки и отправки (требуется разрешение SEND_SMS)</string>
    <string name="sms_poll_interval">Интервал проверки</string>
    <string name="sms_poll_interval_desc">Как часто проверять новые SMS: %d минут</string>
